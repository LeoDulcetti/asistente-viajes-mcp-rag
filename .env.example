# Copia este fichero como ".env" y rellena tu clave.
# La clave de Groq es gratuita: se crea en https://console.groq.com/keys
GROQ_API_KEY=pon-aqui-tu-clave

# Modelo con formato "proveedor:modelo". Debe soportar llamadas a herramientas.
MODELO=groq:llama-3.3-70b-versatile

# El servidor MCP de Airbnb respeta robots.txt por defecto. Ver el README antes de cambiarlo.
AIRBNB_IGNORAR_ROBOTS=false
